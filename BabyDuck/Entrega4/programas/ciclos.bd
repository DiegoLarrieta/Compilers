program ciclos;
var i, j, pares : int;
main {
    i = 0;
    pares = 0;
    while (i < 10) do {
        j = i / 2 * 2;
        if (j != i) {
            print(i, "es impar");
        } else {
            pares = pares + 1;
        };
        i = i + 1;
    };
    if (pares > 3) {
        print("muchos pares", pares);
    };
}
end
